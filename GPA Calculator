            new Course("ITU5309", "Virtual Systems and Services", 3),
            new Course("COU5300", "Artificial Neural Networks", 3),
            new Course("ITU5301", "Software Quality Assurance", 3),
            new Course("ISU5300", "Management Information Systems", 3),
            new Course("ITU5302", "Data Scalability and Analytics", 3),
            new Course("ITU5305", "Enterprise Application Development", 3),
            new Course("ITU5304", "Wireless and Cellular Networks", 3),
            new Course("ITU5308", "Web Technologies", 3),
