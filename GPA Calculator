    }
    
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        System.out.println("==========================================");
        System.out.println("     OUSL BSc IT GPA CALCULATOR");
        System.out.println("==========================================\n");
        
        int level = 0;
        while (true) {
            System.out.print("Enter your Level (3, 4, 5, or 6): ");
            try {
                level = Integer.parseInt(scanner.nextLine().trim());
                if (level == 3 || level == 4 || level == 5 || level == 6) break;
                else System.out.println("Invalid! Please enter 3, 4, 5, or 6");
            } catch (NumberFormatException e) {
                System.out.println("Invalid! Enter a number (3, 4, 5, or 6)");
            }
        }
        
        Course[] courses = COURSES_BY_LEVEL.get(level);
        
        System.out.println("\n==========================================");
        System.out.println("Level " + level + " Courses");
        System.out.println("==========================================\n");
        System.out.println("Instructions:");
        System.out.println("• Enter GRADE (A+, A, A-, B+, B, B-, C+, C, C-)");
        System.out.println("• Enter 'EXEMPT' if you have an EXEMPTION (automatically C grade, GPV 2.00)");
        System.out.println("• Enter 'no' if you DID NOT take the subject");
        System.out.println("• NON-CREDIT subjects (0 credits) do NOT affect GPA");
        System.out.println("• Press ENTER to use default credits");
        System.out.println("==========================================\n");
        
        double totalWeightedGPV = 0;
        int totalCredits = 0;
        int subjectsTaken = 0;
        int exemptSubjects = 0;
        int nonCreditTaken = 0;
        
        for (int i = 0; i < courses.length; i++) {
            Course course = courses[i];
            
            System.out.println("----------------------------------------");
            if (course.isNonCredit) {
                System.out.println((i + 1) + ". " + course.code + " - " + course.name);
                System.out.println("   ⚠ NON-CREDIT SUBJECT (0 credits)");
            } else {
                System.out.println((i + 1) + ". " + course.code + " - " + course.name);
                System.out.println("   Credits: " + course.defaultCredits);
            }
            
            System.out.print("   Grade / EXEMPT / no: ");
            String input = scanner.nextLine().trim().toLowerCase();
            
            // Skip subject
            if (input.equals("no")) {
                System.out.println("   ⊘ Skipped\n");
                continue;
            }
            
            // Handle exemption
            boolean isExempt = false;
            String grade = input.toUpperCase();
            if (input.equals("exempt")) {
                isExempt = true;
                grade = "C";  // Exemption = C grade (min pass)
                System.out.println("   ✓ EXEMPTION detected. Auto-assigning grade: C (GPV 2.00)");
            }
            
            // Validate grade
            if (!GRADE_TO_GPV.containsKey(grade)) {
                System.out.println("   ✗ Invalid! Use: A+, A, A-, B+, B, B-, C+, C, C-, EXEMPT, or no");
                System.out.println("   ⊘ Skipping...\n");
                continue;
            }
            
            double gpv = GRADE_TO_GPV.get(grade);
            
            // Non-credit subjects
            if (course.isNonCredit) {
                System.out.printf("   ✓ Non-credit | Grade: %s | PASS (No GPA effect)\n\n", grade);
                nonCreditTaken++;
                continue;
            }
            
            // Credit subject - ask for credits
            System.out.print("   Credits (Press ENTER for " + course.defaultCredits + "): ");
            String creditInput = scanner.nextLine().trim();
            int credits;
            if (creditInput.isEmpty()) {
                credits = course.defaultCredits;
            } else {
                try {
                    credits = Integer.parseInt(creditInput);
                    if (credits <= 0) {
                        System.out.println("   Invalid credits! Using default: " + course.defaultCredits);
                        credits = course.defaultCredits;
                    }
                } catch (NumberFormatException e) {
                    System.out.println("   Invalid! Using default: " + course.defaultCredits);
                    credits = course.defaultCredits;
                }
            }
            
            totalWeightedGPV += credits * gpv;
            totalCredits += credits;
            subjectsTaken++;
            if (isExempt) exemptSubjects++;
            
            System.out.printf("   ✓ Added | Credits: %d | Grade: %s | GPV: %.2f\n\n", credits, grade, gpv);
        }
        
        System.out.println("\n==========================================");
        System.out.println("              RESULTS");
        System.out.println("==========================================");
        System.out.println("Subjects Taken (Credit)     : " + subjectsTaken);
        System.out.println("Exemptions Included         : " + exemptSubjects);
        System.out.println("Non-Credit Subjects Taken   : " + nonCreditTaken);
        System.out.println("Total Credits (for GPA)     : " + totalCredits);
        System.out.println("Total Weighted GPV          : " + String.format("%.2f", totalWeightedGPV));
        
        if (totalCredits == 0) {
            System.out.println("\n⚠ No credit subjects added! GPA cannot be calculated.");
        } else {
            double gpa = totalWeightedGPV / totalCredits;
            System.out.printf("\n📊 GPA                       : %.2f\n", gpa);
            
            System.out.println("\n--- Degree Classification (BSc IT 90 credits) ---");
            if (gpa >= 3.70) {
                System.out.println("🏆 First Class Honours (GPA ≥ 3.70)");
            } else if (gpa >= 3.30) {
                System.out.println("📘 Second Class Honours - Upper Division (GPA ≥ 3.30)");
            } else if (gpa >= 3.00) {
                System.out.println("📗 Second Class Honours - Lower Division (GPA ≥ 3.00)");
            } else if (gpa >= 2.00) {
                System.out.println("✅ Pass (GPA ≥ 2.00)");
            } else {
                System.out.println("❌ Not eligible for degree (GPA < 2.00)");
            }
        }
        System.out.println("==========================================");
        
        scanner.close();
    }
}
