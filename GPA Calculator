import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;
import java.util.ArrayList;

public class GPACalculator {

    private static final Map<String, Double> GRADE_TO_GPV = new HashMap<>();

    static {
        GRADE_TO_GPV.put("A+", 4.00);
        GRADE_TO_GPV.put("A", 4.00);
        GRADE_TO_GPV.put("A-", 3.70);
        GRADE_TO_GPV.put("B+", 3.30);
        GRADE_TO_GPV.put("B", 3.00);
        GRADE_TO_GPV.put("B-", 2.70);
        GRADE_TO_GPV.put("C+", 2.30);
        GRADE_TO_GPV.put("C", 2.00);
        GRADE_TO_GPV.put("C-", 1.70);
        GRADE_TO_GPV.put("D+", 1.30);
        GRADE_TO_GPV.put("D", 1.00);
        GRADE_TO_GPV.put("D-", 0.70);
        GRADE_TO_GPV.put("E", 0.00);
        GRADE_TO_GPV.put("EXEMPT", 2.00);
    }

    static class Course {
        String code;
        String name;
        int defaultCredits;
        boolean isNonCredit;
        int level;

        Course(String code, String name, int defaultCredits, int level) {
            this.code = code;
            this.name = name;
            this.defaultCredits = defaultCredits;
            this.isNonCredit = (defaultCredits == 0);
            this.level = level;
        }
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("==========================================");
        System.out.println("     OUSL BSc IT GPA CALCULATOR");
        System.out.println("   (Cumulative from Level 3 onwards)");
        System.out.println("==========================================\n");

        int currentLevel = 0;
        while (true) {
            System.out.print("Enter your current Level (3, 4, 5, or 6): ");
            try {
                currentLevel = Integer.parseInt(scanner.nextLine().trim());
                if (currentLevel >= 3 && currentLevel <= 6) break;
                else System.out.println("Invalid! Please enter 3, 4, 5, or 6");
            } catch (NumberFormatException e) {
                System.out.println("Invalid! Enter a number (3, 4, 5, or 6)");
            }
        }

        // Manually create all courses (no streams)
        ArrayList<Course> allCourses = new ArrayList<>();

        // Level 3
        allCourses.add(new Course("COU3300", "Computer Organization and Communication", 3, 3));
        allCourses.add(new Course("COU3301", "Database Management Systems", 3, 3));
        allCourses.add(new Course("COU3202", "System Analysis and Design", 2, 3));
        allCourses.add(new Course("ADU3330", "Discrete Mathematics I", 3, 3));
        allCourses.add(new Course("COU3304", "Fundamentals of Programming", 3, 3));
        allCourses.add(new Course("COU3303", "Software Engineering", 3, 3));
        allCourses.add(new Course("ITU3201", "Web Development", 2, 3));
        allCourses.add(new Course("COU3305", "Computer Security Concepts", 3, 3));
        allCourses.add(new Course("ISU3300", "Fundamentals of Information Systems", 3, 3));
        allCourses.add(new Course("COU3306", "Data Structures and Algorithms", 3, 3));
        allCourses.add(new Course("ISU3201", "IT Organization", 2, 3));
        allCourses.add(new Course("LTE3426", "English for Academic Purposes (EAP)", 4, 3));
        allCourses.add(new Course("FDE3030", "Empowering for Independent Learning (EFIL) - NON-CREDIT", 0, 3));
        allCourses.add(new Course("ADE3430", "Foundational Mathematics", 4, 3));
        allCourses.add(new Course("COE3200", "Communication Skills for Computing - NON-CREDIT", 0, 3));

        // Level 4
        allCourses.add(new Course("COU4300", "Object Oriented Programming", 3, 4));
        allCourses.add(new Course("COU4201", "Knowledge Representation and Logic Programming", 2, 4));
        allCourses.add(new Course("COU4302", "Operating Systems", 3, 4));
        allCourses.add(new Course("ISU4200", "Professional Practices and Ethics", 2, 4));
        allCourses.add(new Course("ADU4230", "Discrete Mathematics II", 2, 4));
        allCourses.add(new Course("COU4304", "Computer Architecture", 3, 4));
        allCourses.add(new Course("COU4303", "Artificial Intelligence", 3, 4));
        allCourses.add(new Course("COU4305", "Computer Networks", 3, 4));
        allCourses.add(new Course("COU4306", "Cryptography", 3, 4));
        allCourses.add(new Course("ITU4200", "Software Validation and Assurance", 2, 4));
        allCourses.add(new Course("ADU4231", "Probability and Statistics", 2, 4));
        allCourses.add(new Course("ITU4202", "User Experience Design", 2, 4));

        // Level 5
        allCourses.add(new Course("ITU5300", "Human-Computer Interaction", 3, 5));
        allCourses.add(new Course("ADU5330", "Inferential Techniques and Statistical Modeling", 3, 5));
        allCourses.add(new Course("ITU5303", "Multimedia Design and Technology", 3, 5));
        allCourses.add(new Course("ISU5301", "Industry Sustainability and Law", 3, 5));
        allCourses.add(new Course("ITU5307", "Cybersecurity", 3, 5));
        allCourses.add(new Course("ITU5306", "Internet of Things", 3, 5));
        allCourses.add(new Course("ITU5309", "Virtual Systems and Services", 3, 5));
        allCourses.add(new Course("COU5300", "Artificial Neural Networks", 3, 5));
        allCourses.add(new Course("ITU5301", "Software Quality Assurance", 3, 5));
        allCourses.add(new Course("ISU5300", "Management Information Systems", 3, 5));
        allCourses.add(new Course("ITU5302", "Data Scalability and Analytics", 3, 5));
        allCourses.add(new Course("ITU5305", "Enterprise Application Development", 3, 5));
        allCourses.add(new Course("ITU5304", "Wireless and Cellular Networks", 3, 5));
        allCourses.add(new Course("ITU5308", "Web Technologies", 3, 5));
        allCourses.add(new Course("COU5301", "Cloud Computing", 3, 5));
        allCourses.add(new Course("ITE5120", "Industry Readiness", 1, 5));
        allCourses.add(new Course("ITE5621", "Industrial Training", 6, 5));
        allCourses.add(new Course("ITE5622", "Industrial Application Development Project", 6, 5));

        // Level 6
        allCourses.add(new Course("ITU6621", "Research Project", 6, 6));
        allCourses.add(new Course("COU6303", "Advanced Database Management Systems", 3, 6));
        allCourses.add(new Course("COU6304", "Advanced Data Structures and Algorithms", 3, 6));
        allCourses.add(new Course("ITU6302", "Distributed Systems", 3, 6));
        allCourses.add(new Course("ISU6300", "IT Risk Management", 3, 6));
        allCourses.add(new Course("COU6308", "Machine Learning", 3, 6));
        allCourses.add(new Course("COU6309", "Information Security", 3, 6));
        allCourses.add(new Course("COU6306", "Data Mining", 3, 6));
        allCourses.add(new Course("COU6307", "Digital Forensics", 3, 6));
        allCourses.add(new Course("ISU6302", "Social Media and Global Computing", 3, 6));
        allCourses.add(new Course("ISU6305", "IT Project Management", 3, 6));

        // Filter courses up to current level
        ArrayList<Course> coursesToShow = new ArrayList<>();
        for (Course c : allCourses) {
            if (c.level >= 3 && c.level <= currentLevel) {
                coursesToShow.add(c);
            }
        }

        System.out.println("\n==========================================");
        System.out.println("Courses from Level 3 to Level " + currentLevel);
        System.out.println("==========================================\n");
        System.out.println("Instructions:");
        System.out.println("• Enter GRADE (A+, A, A-, B+, B, B-, C+, C, C-, D+, D, D-, E)");
        System.out.println("• Enter 'EXEMPT' if you have an EXEMPTION (auto = C grade, GPV 2.00)");
        System.out.println("• Enter 'no' if you DID NOT take the subject");
        System.out.println("• Credits automatically use default value (press ENTER after typing grade)");
        System.out.println("==========================================\n");

        double totalWeightedGPV = 0;
        int totalCredits = 0;
        int subjectsTaken = 0;
        int exemptSubjects = 0;
        int nonCreditTaken = 0;
        int index = 0;

        for (Course course : coursesToShow) {
            index++;

            System.out.println("----------------------------------------");
            System.out.println("Level " + course.level + " | Subject " + index);
            if (course.isNonCredit) {
                System.out.println(course.code + " - " + course.name);
                System.out.println("   ⚠ NON-CREDIT SUBJECT (0 credits)");
            } else {
                System.out.println(course.code + " - " + course.name);
                System.out.println("   Default Credits: " + course.defaultCredits);
            }

            System.out.print("   Grade / EXEMPT / no: ");
            String input = scanner.nextLine().trim().toLowerCase();

            if (input.equals("no")) {
                System.out.println("   ⊘ Skipped\n");
                continue;
            }

            boolean isExempt = input.equals("exempt");
            String grade = isExempt ? "C" : input.toUpperCase();

            if (!GRADE_TO_GPV.containsKey(grade)) {
                System.out.println("   ✗ Invalid! Use: A+, A, A-, B+, B, B-, C+, C, C-, D+, D, D-, E, EXEMPT, or no\n");
                continue;
            }

            double gpv = GRADE_TO_GPV.get(grade);

            // Non-credit subjects
            if (course.isNonCredit) {
                System.out.printf("   ✓ Non-credit | Grade: %s | PASS (No GPA effect)\n\n", grade);
                nonCreditTaken++;
                continue;
            }

            int credits = course.defaultCredits;
            totalWeightedGPV += credits * gpv;
            totalCredits += credits;
            subjectsTaken++;
            if (isExempt) exemptSubjects++;

            System.out.printf("   ✓ Added | Credits: %d (default) | Grade: %s | GPV: %.2f\n\n", credits, grade, gpv);
        }

        System.out.println("\n==========================================");
        System.out.println("              RESULTS");
        System.out.println("==========================================");
        System.out.println("Levels included      : 3 to " + currentLevel);
        System.out.println("Subjects Taken       : " + subjectsTaken);
        System.out.println("Exemptions Included  : " + exemptSubjects);
        System.out.println("Non-Credit Subjects  : " + nonCreditTaken);
        System.out.println("Total Credits (GPA)  : " + totalCredits);
        System.out.println("Total Weighted GPV   : " + String.format("%.2f", totalWeightedGPV));

        if (totalCredits == 0) {
            System.out.println("\n⚠ No credit subjects added! GPA cannot be calculated.");
        } else {
            double gpa = totalWeightedGPV / totalCredits;
            System.out.printf("\n📊 CUMULATIVE GPA (Level 3 to %d): %.2f\n", currentLevel, gpa);

            System.out.println("\n--- Degree Classification ---");
            if (gpa >= 3.70) {
                System.out.println("🏆 First Class Honours (GPA ≥ 3.70)");
            } else if (gpa >= 3.30) {
                System.out.println("📘 Second Class Honours - Upper Division (GPA ≥ 3.30)");
            } else if (gpa >= 3.00) {
                System.out.println("📗 Second Class Honours - Lower Division (GPA ≥ 3.00)");
            } else if (gpa >= 2.00) {
                System.out.println("✅ Pass (GPA ≥ 2.00)");
            } else {
                System.out.println("❌ Not eligible for degree (GPA < 2.00)");
            }
        }
        System.out.println("==========================================");

        scanner.close();
    }
}
