import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class GPACalculator {
    
    private static final Map<String, Double> GRADE_TO_GPV = new HashMap<>();
    
    static {
        GRADE_TO_GPV.put("A+", 4.00);
        GRADE_TO_GPV.put("A", 4.00);
        GRADE_TO_GPV.put("A-", 3.70);
        GRADE_TO_GPV.put("B+", 3.30);
        GRADE_TO_GPV.put("B", 3.00);
        GRADE_TO_GPV.put("B-", 2.70);
        GRADE_TO_GPV.put("C+", 2.30);
        GRADE_TO_GPV.put("C", 2.00);
        GRADE_TO_GPV.put("C-", 1.70);
        GRADE_TO_GPV.put("EXEMPT", 2.00);  // Exemption = Grade C (2.00)
    }
    
    static class Course {
        String code;
        String name;
        int defaultCredits;
        boolean isNonCredit;
        
        Course(String code, String name, int defaultCredits) {
            this.code = code;
            this.name = name;
            this.defaultCredits = defaultCredits;
            this.isNonCredit = (defaultCredits == 0);
        }
    }
    
    private static final Map<Integer, Course[]> COURSES_BY_LEVEL = new HashMap<>();
    
    static {
        // Level 3 
        COURSES_BY_LEVEL.put(3, new Course[]{
            new Course("COU3300", "Computer Organization and Communication", 3),
            new Course("COU3301", "Database Management Systems", 3),
            new Course("COU3202", "System Analysis and Design", 2),
            new Course("ADU3330", "Discrete Mathematics I", 3),
            new Course("COU3304", "Fundamentals of Programming", 3),
            new Course("COU3303", "Software Engineering", 3),
            new Course("ITU3201", "Web Development", 2),
            new Course("COU3305", "Computer Security Concepts", 3),
            new Course("ISU3300", "Fundamentals of Information Systems", 3),
            new Course("COU3306", "Data Structures and Algorithms", 3),
            new Course("ISU3201", "IT Organization", 2),
            new Course("LTE3426", "English for Academic Purposes (EAP)", 4),
            new Course("FDE3030", "Empowering for Independent Learning (EFIL) - NON-CREDIT", 0),
            new Course("ADE3430", "Foundational Mathematics", 4),
            new Course("COE3200", "Communication Skills for Computing - NON-CREDIT", 0)
        });
        
        // Level 4 
        COURSES_BY_LEVEL.put(4, new Course[]{
            new Course("COU4300", "Object Oriented Programming", 3),
            new Course("COU4201", "Knowledge Representation and Logic Programming", 2),
            new Course("COU4302", "Operating Systems", 3),
            new Course("ISU4200", "Professional Practices and Ethics", 2),
            new Course("ADU4230", "Discrete Mathematics II", 2),
            new Course("COU4304", "Computer Architecture", 3),
            new Course("COU4303", "Artificial Intelligence", 3),
            new Course("COU4305", "Computer Networks", 3),
            new Course("COU4306", "Cryptography", 3),
            new Course("ITU4200", "Software Validation and Assurance", 2),
            new Course("ADU4231", "Probability and Statistics", 2),
            new Course("ITU4202", "User Experience Design", 2)
        });
        // Level 5
        COURSES_BY_LEVEL.put(5, new Course[]{
            new Course("ITU5300", "Human-Computer Interaction", 3),
            new Course("ADU5330", "Inferential Techniques and Statistical Modeling", 3),
            new Course("ITU5303", "Multimedia Design and Technology", 3),
            new Course("ISU5301", "Industry Sustainability and Law", 3),
            new Course("ITU5307", "Cybersecurity", 3),
